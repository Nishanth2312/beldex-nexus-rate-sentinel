# ========================================================
# Beldex Nexus Rate Sentinel - Configuration (.env)
# ========================================================

# Server
HOST=0.0.0.0
PORT=8080

# Monitoring Engine
POLL_INTERVAL_SECONDS=30
DIFF_WINDOW_MINUTES=30
SURGE_THRESHOLD_PERCENT_30M=3.0
TARGET_SELL_PRICE_USD=0.0800
TARGET_SELL_PRICE_INR=7.50
COOLDOWN_MINUTES=15
USER_HOLDINGS_BDX=10000

# Nexus.vin Portal Integration
NEXUS_ENABLED=true
NEXUS_URL=https://nexus.vin
NEXUS_COOKIE=
NEXUS_AUTH_TOKEN=

# Telegram Alerting
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (SMTP) Alerting
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
EMAIL_USE_TLS=true

# SMS Alerting
SMS_ENABLED=false
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=
FAST2SMS_API_KEY=
FAST2SMS_NUMBERS=
SMS_WEBHOOK_URL=

# Discord / Webhook Alerting
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=
